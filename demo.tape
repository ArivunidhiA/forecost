Output assets/demo.gif

Require forecost

Set Shell "bash"
Set FontSize 16
Set Width 1200
Set Height 600
Set Padding 20
Set Margin 20
Set MarginFill "#1a1b26"
Set BorderRadius 8
Set WindowBar Colorful
Set WindowBarSize 40
Set TypingSpeed 50ms
Set Theme "Dracula"

Type "forecost calc 'Explain quantum computing in simple terms'"
Sleep 500ms
Enter
Sleep 4s

Type "forecost demo"
Sleep 500ms
Enter
Sleep 5s

Type "forecost status"
Sleep 500ms
Enter
Sleep 3s

Type "forecost price --tier 1"
Sleep 500ms
Enter
Sleep 4s
