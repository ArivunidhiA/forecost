{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/bootstrap.sh", "timeout": 120 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_DATA}\"/venv/bin/forecost-hook session-start", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_DATA}\"/venv/bin/forecost-hook prompt-submit", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task|Bash|WebFetch|WebSearch",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_DATA}\"/venv/bin/forecost-hook pre-tool", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_DATA}\"/venv/bin/forecost-hook stop", "timeout": 30, "async": true }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_DATA}\"/venv/bin/forecost-hook stop", "timeout": 30, "async": true }
        ]
      }
    ]
  }
}
